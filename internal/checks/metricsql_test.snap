[TestMetricsQLImpossibleCheck/vector(0)_>_0_inside_WITH - 1]
- description: vector(0) > 0 inside WITH
  content: |
    - alert: foo
      expr: 'WITH (z = vector(0)) z > 0'
  output: |
    2 |   expr: 'WITH (z = vector(0)) z > 0'
                                      ^
                                      `z > 0` always evaluates to `0 > 0` which is not possible, so it will
                                      never return anything.
  problem:
    reporter: promql/impossible
    summary: dead code in query
    details: ""
    diagnostics:
        - message: '`z > 0` always evaluates to `0 > 0` which is not possible, so it will never return anything.'
          firstcolumn: 22
          lastcolumn: 22
          kind: 0
    lines:
        first: 2
        last: 2
    severity: 1
    anchor: 0

